{
  "name": "@jaywoo0830a/logos",
  "version": "0.4.1",
  "description": "Matplotlib-parity math figure DSL in pure JavaScript (Node ESM) — one chainable scene emits SVG, PNG, TikZ, Asymptote and JSXGraph.",
  "type": "module",
  "main": "index.js",
  "types": "./types/index.d.ts",
  "bin": {
    "logos": "bin/logos.mjs"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./kit.js": {
      "types": "./types/kit.d.ts",
      "default": "./kit.js"
    },
    "./linalg.js": {
      "types": "./types/linalg.d.ts",
      "default": "./linalg.js"
    },
    "./complex.js": {
      "types": "./types/complex.d.ts",
      "default": "./complex.js"
    },
    "./annotate.js": {
      "types": "./types/annotate.d.ts",
      "default": "./annotate.js"
    },
    "./transform.js": {
      "types": "./types/transform.d.ts",
      "default": "./transform.js"
    },
    "./sprite.js": {
      "types": "./types/sprite.d.ts",
      "default": "./sprite.js"
    },
    "./server.js": {
      "types": "./types/server.d.ts",
      "default": "./server.js"
    },
    "./core/*.js": {
      "types": "./types/core/*.d.ts",
      "default": "./core/*.js"
    },
    "./shapes/*.js": {
      "types": "./types/shapes/*.d.ts",
      "default": "./shapes/*.js"
    },
    "./solver/*.js": {
      "types": "./types/solver/*.d.ts",
      "default": "./solver/*.js"
    },
    "./symbolic/*.js": {
      "types": "./types/symbolic/*.d.ts",
      "default": "./symbolic/*.js"
    },
    "./backend/*.js": {
      "types": "./types/backend/*.d.ts",
      "default": "./backend/*.js"
    },
    "./plugins/*.js": {
      "types": "./types/plugins/*.d.ts",
      "default": "./plugins/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "types",
    "index.js",
    "core",
    "shapes",
    "solver",
    "symbolic",
    "backend",
    "assets",
    "bin",
    "plugins",
    "scripts",
    "kit.js",
    "linalg.js",
    "complex.js",
    "annotate.js",
    "transform.js",
    "sprite.js",
    "server.js",
    "Dockerfile",
    "docker-compose.yml",
    "examples/workflow/sketches",
    "examples/workflow/README.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/guides/KIT.md",
    "docs/guides/WORKFLOW.md",
    "docs/spec/DSL.md",
    "docs/spec/INTERFACE.md",
    "docs/extend/PLUGIN.md",
    "docs/extend/ADAPT.md"
  ],
  "scripts": {
    "test": "bash scripts/test.sh",
    "types": "tsc -p tsconfig.types.json",
    "test:unit": "node --test test/*.test.js",
    "prepublishOnly": "npm test",
    "prepack": "npm run types && node -e \"const p=require('./package.json');if(!/^@[a-z0-9-]+\\//.test(p.name))throw new Error('publishable name required: '+p.name)\"",
    "test:svg": "node --test test/senarios.test.js",
    "snap:update": "UPDATE=1 node --test test/snapshots.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parity11ab": "node examples/parity/mpl_parity_11ab.js",
    "parity9b": "node examples/parity/mpl_parity_9b.js",
    "parity9c": "node examples/parity/mpl_parity_9c.js",
    "parity12a2": "node examples/parity/mpl_parity_12a2.js",
    "parity12a1": "node examples/parity/mpl_parity_12a1.js",
    "plugin-demo": "node examples/plugin/plugin_demo.js",
    "clean-code": "node examples/clean-code/run-all.js",
    "render": "bash scripts/render.sh",
    "serve:out": "bash scripts/serve.sh out 18080",
    "workflow": "bash scripts/install.sh && bash scripts/render.sh -p examples/workflow -s sketches -o out",
    "examples": "node examples/parity/mpl_parity_11ab.js && node examples/parity/mpl_parity_9b.js && node examples/parity/mpl_parity_9c.js && node examples/parity/mpl_parity_12a2.js && node examples/parity/mpl_parity_12a1.js && node examples/plugin/plugin_demo.js",
    "serve": "bash scripts/serve.sh"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.27.0",
    "katex": "^0.18.7",
    "node-tikzjax": "^1.0.5"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "math",
    "mathematics",
    "figure",
    "plot",
    "graph",
    "geometry",
    "matplotlib",
    "dsl",
    "svg",
    "png",
    "tikz",
    "asymptote",
    "jsxgraph",
    "katex",
    "latex",
    "teaching",
    "textbook",
    "3d"
  ],
  "author": "jaywoo0830a",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaywoo0830a/logos.git"
  },
  "bugs": {
    "url": "https://github.com/jaywoo0830a/logos/issues"
  },
  "homepage": "https://github.com/jaywoo0830a/logos#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "typescript": "^5.9.2"
  }
}
