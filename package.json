{
  "name": "logos",
  "version": "0.1.0",
  "description": "클라이언트 코드 미리보기 / DSL 구현 (Pure JS, Node ESM)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "core",
    "shapes",
    "solver",
    "symbolic",
    "backend",
    "assets"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:svg": "node --test test/senarios.test.js",
    "snap:update": "UPDATE=1 node --test test/snapshots.test.js",
    "parity9b": "node examples/mpl_parity_9b.js",
    "parity9c": "node examples/mpl_parity_9c.js",
    "examples": "node examples/mpl_parity_9b.js && node examples/mpl_parity_9c.js",
    "serve": "node server.js"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.27.0",
    "katex": "^0.18.7",
    "node-tikzjax": "^1.0.5"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT"
}
