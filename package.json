{
  "name": "@jaywoo0830a/logos",
  "version": "0.4.0",
  "description": "Matplotlib-parity math figure DSL in pure JavaScript (Node ESM) — one chainable scene emits SVG, PNG, TikZ, Asymptote and JSXGraph.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "logos": "bin/logos.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./kit.js": "./kit.js",
    "./linalg.js": "./linalg.js",
    "./complex.js": "./complex.js",
    "./annotate.js": "./annotate.js",
    "./transform.js": "./transform.js",
    "./sprite.js": "./sprite.js",
    "./server.js": "./server.js",
    "./core/*.js": "./core/*.js",
    "./shapes/*.js": "./shapes/*.js",
    "./solver/*.js": "./solver/*.js",
    "./symbolic/*.js": "./symbolic/*.js",
    "./backend/*.js": "./backend/*.js",
    "./plugins/*.js": "./plugins/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "core",
    "shapes",
    "solver",
    "symbolic",
    "backend",
    "assets",
    "bin",
    "plugins",
    "scripts",
    "kit.js",
    "linalg.js",
    "complex.js",
    "annotate.js",
    "transform.js",
    "sprite.js",
    "server.js",
    "Dockerfile",
    "docker-compose.yml",
    "examples/workflow/sketches",
    "examples/workflow/README.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "KIT.md",
    "PLUGIN.md",
    "WORKFLOW.md",
    "DSL.md",
    "INTERFACE.md"
  ],
  "scripts": {
    "test": "bash scripts/test.sh",
    "test:unit": "node --test test/*.test.js",
    "prepublishOnly": "npm test",
    "prepack": "node -e \"const p=require('./package.json');if(!/^@[a-z0-9-]+\\//.test(p.name))throw new Error('publishable name required: '+p.name)\"",
    "test:svg": "node --test test/senarios.test.js",
    "snap:update": "UPDATE=1 node --test test/snapshots.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "parity11ab": "node examples/mpl_parity_11ab.js",
    "parity9b": "node examples/mpl_parity_9b.js",
    "parity9c": "node examples/mpl_parity_9c.js",
    "parity12a2": "node examples/mpl_parity_12a2.js",
    "parity12a1": "node examples/mpl_parity_12a1.js",
    "plugin-demo": "node examples/plugin_demo.js",
    "render": "bash scripts/render.sh",
    "serve:out": "bash scripts/serve.sh out 18080",
    "workflow": "bash scripts/install.sh && bash scripts/render.sh -p examples/workflow -s sketches -o out",
    "examples": "node examples/mpl_parity_11ab.js && node examples/mpl_parity_9b.js && node examples/mpl_parity_9c.js && node examples/mpl_parity_12a2.js && node examples/mpl_parity_12a1.js && node examples/plugin_demo.js",
    "serve": "bash scripts/serve.sh"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.27.0",
    "katex": "^0.18.7",
    "node-tikzjax": "^1.0.5"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "math",
    "mathematics",
    "figure",
    "plot",
    "graph",
    "geometry",
    "matplotlib",
    "dsl",
    "svg",
    "png",
    "tikz",
    "asymptote",
    "jsxgraph",
    "katex",
    "latex",
    "teaching",
    "textbook",
    "3d"
  ],
  "author": "jaywoo0830a",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaywoo0830a/logos.git"
  },
  "bugs": {
    "url": "https://github.com/jaywoo0830a/logos/issues"
  },
  "homepage": "https://github.com/jaywoo0830a/logos#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
