{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "types",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": [
    "index.js",
    "kit.js",
    "annotate.js",
    "transform.js",
    "complex.js",
    "linalg.js",
    "sprite.js",
    "server.js",
    "core/**/*.js",
    "shapes/**/*.js",
    "solver/**/*.js",
    "symbolic/**/*.js",
    "backend/**/*.js",
    "plugins/**/*.js"
  ]
}
